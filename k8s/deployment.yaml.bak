apiVersion: apps/v1
kind: Deployment
metadata:
  name: gestion-livres
  labels:
    app: gestion-livres
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gestion-livres
  template:
    metadata:
      labels:
        app: gestion-livres
    spec:
      containers:
        - name: gestion-livres
          image: gestion-livres:1.0
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
          env:
            - name: SPRING_DATASOURCE_URL
              value: "jdbc:mysql://mysql:3306/biblio?allowPublicKeyRetrieval=true&useSSL=false"
            - name: SPRING_DATASOURCE_USERNAME
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: MYSQL_USER
            - name: SPRING_DATASOURCE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: MYSQL_PASSWORD
